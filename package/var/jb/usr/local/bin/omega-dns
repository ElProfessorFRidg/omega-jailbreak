#!/var/jb/usr/bin/sh
# ---------------------------------------------------------------------------
#  omega-dns  -  on-device ("local") DNS block for the Apple revocation
#  domains, so sideloaded apps stay valid ONLINE without a VPS.
#
#  How it works:
#    * runs dnsmasq on 127.0.0.1:53 as a root LaunchDaemon, answering the 4
#      revocation domains with 0.0.0.0 and forwarding everything else to an
#      upstream resolver (default 1.1.1.1);
#    * generates a DNS configuration profile (.mobileconfig) that points iOS
#      at 127.0.0.1 - the user installs it so the whole device uses the
#      local resolver.
#
#  Subcommands:  install [upstream] | remove | status
#
#  dnsmasq is not bundled; install it from your package manager (Procursus:
#  "dnsmasq"). 'status' and 'install' say so clearly if it is missing.
# ---------------------------------------------------------------------------
export PATH=/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin
set -u

PREFIX=""
[ -d /var/jb ] && PREFIX=/var/jb

CONF="$PREFIX/etc/omega-dnsmasq.conf"
PLIST="$PREFIX/Library/LaunchDaemons/party.jailbreak.omega.dnsmasq.plist"
LABEL=party.jailbreak.omega.dnsmasq
PROFILE=/var/mobile/.omega/Omega-LocalDNS.mobileconfig
LOG=/var/mobile/omega-dns.log
DOMAINS="ocsp.apple.com ppq.apple.com crl.apple.com valid.apple.com"

LAUNCHCTL=launchctl
[ -x /var/jb/usr/bin/launchctl ] && LAUNCHCTL=/var/jb/usr/bin/launchctl

log() { logger -t omega-dns "$*" 2>/dev/null; echo "[$(date '+%H:%M:%S')] $*"; }

dnsmasq_bin() {
    for p in /var/jb/usr/sbin/dnsmasq /var/jb/usr/bin/dnsmasq /usr/sbin/dnsmasq /usr/bin/dnsmasq; do
        [ -x "$p" ] && { echo "$p"; return 0; }
    done
    command -v dnsmasq 2>/dev/null && return 0
    return 1
}

write_conf() {
    upstream="$1"
    mkdir -p "$(dirname "$CONF")" 2>/dev/null
    {
        echo "# Generated by omega-dns - local revocation block."
        echo "listen-address=127.0.0.1"
        echo "bind-interfaces"
        echo "no-resolv"
        echo "cache-size=1000"
        echo "server=$upstream"
        for d in $DOMAINS; do echo "address=/$d/0.0.0.0"; done
    } > "$CONF"
    log "wrote $CONF (upstream=$upstream)"
}

write_plist() {
    bin="$1"
    mkdir -p "$(dirname "$PLIST")" 2>/dev/null
    cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$bin</string>
        <string>-k</string>
        <string>-C</string>
        <string>$CONF</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>$LOG</string>
    <key>StandardErrorPath</key>
    <string>$LOG</string>
</dict>
</plist>
EOF
    chown root:wheel "$PLIST" 2>/dev/null || true
    log "wrote $PLIST"
}

write_profile() {
    upstream="$1"
    mkdir -p "$(dirname "$PROFILE")" 2>/dev/null
    uuid1=$(uuidgen 2>/dev/null || echo "26C21BBB-BEB4-4600-B9E3-4BA36D1F68DE")
    uuid2=$(uuidgen 2>/dev/null || echo "42EBFA66-2373-497B-B640-D49AFCED7600")
    cat > "$PROFILE" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>DNSSettings</key>
      <dict>
        <key>DNSProtocol</key>
        <string>Plain</string>
        <key>ServerAddresses</key>
        <array>
          <string>127.0.0.1</string>
        </array>
      </dict>
      <key>PayloadDescription</key>
      <string>Route DNS to the on-device Omega resolver (blocks Apple revocation lookups)</string>
      <key>PayloadDisplayName</key>
      <string>Omega Local DNS</string>
      <key>PayloadIdentifier</key>
      <string>party.jailbreak.omega.localdns</string>
      <key>PayloadType</key>
      <string>com.apple.dnsSettings.managed</string>
      <key>PayloadUUID</key>
      <string>$uuid2</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
    </dict>
  </array>
  <key>PayloadDisplayName</key>
  <string>Omega Local DNS</string>
  <key>PayloadIdentifier</key>
  <string>party.jailbreak.omega.localdns.profile</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>$uuid1</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
</dict>
</plist>
EOF
    chown mobile:mobile "$PROFILE" 2>/dev/null || true
    chmod 644 "$PROFILE" 2>/dev/null || true
    log "wrote profile $PROFILE (upstream=$upstream)"
}

install_dns() {
    if [ "$(id -u)" != "0" ]; then echo "ERROR: run as root (via the app)."; return 1; fi
    upstream=$(printf '%s' "${1:-1.1.1.1}" | tr -cd '0-9.:')
    [ -n "$upstream" ] || upstream=1.1.1.1

    bin=$(dnsmasq_bin) || {
        echo "dnsmasq is NOT installed."
        echo "Install it from your package manager (Procursus package: dnsmasq),"
        echo "then run Install again. The DNS profile is still generated below so"
        echo "you can prepare it in the meantime."
        write_conf "$upstream"
        write_profile "$upstream"
        echo "profile: $PROFILE"
        return 3
    }

    write_conf "$upstream"
    write_plist "$bin"
    write_profile "$upstream"

    $LAUNCHCTL bootout system "$PLIST" 2>/dev/null \
        || $LAUNCHCTL bootout "system/$LABEL" 2>/dev/null || true
    $LAUNCHCTL enable "system/$LABEL" 2>/dev/null || true
    $LAUNCHCTL bootstrap system "$PLIST" 2>/dev/null \
        || $LAUNCHCTL load -w "$PLIST" 2>/dev/null || true
    $LAUNCHCTL kickstart -k "system/$LABEL" 2>/dev/null || true

    echo "Local DNS resolver installed and started (dnsmasq @ 127.0.0.1:53)."
    echo "Blocking: $DOMAINS"
    echo "Upstream: $upstream"
    echo
    echo "Next: install the DNS profile so iOS routes through it:"
    echo "  $PROFILE"
    echo "Open it from the app (Install profile), then Settings -> Profile -> Install."
    return 0
}

remove_dns() {
    if [ "$(id -u)" != "0" ]; then echo "ERROR: run as root (via the app)."; return 1; fi
    $LAUNCHCTL bootout system "$PLIST" 2>/dev/null \
        || $LAUNCHCTL bootout "system/$LABEL" 2>/dev/null \
        || $LAUNCHCTL unload "$PLIST" 2>/dev/null || true
    rm -f "$PLIST" "$CONF" "$PROFILE" 2>/dev/null
    echo "Local DNS resolver removed (daemon, config, profile)."
    echo "Also remove the 'Omega Local DNS' profile in Settings -> General ->"
    echo "VPN & Device Management if you installed it."
    return 0
}

status_dns() {
    echo "== local DNS status =="
    if bin=$(dnsmasq_bin); then echo "dnsmasq:   $bin"; else echo "dnsmasq:   NOT INSTALLED (Procursus package: dnsmasq)"; fi
    if [ -f "$CONF" ]; then echo "config:    $CONF"; else echo "config:    (none)"; fi
    if [ -f "$PLIST" ]; then echo "daemon:    $PLIST"; else echo "daemon:    (not installed)"; fi
    if [ -f "$PROFILE" ]; then echo "profile:   $PROFILE"; else echo "profile:   (not generated)"; fi
    echo
    echo "== daemon loaded? =="
    $LAUNCHCTL print "system/$LABEL" 2>/dev/null | sed -n '1,6p' || echo "(not loaded)"
    echo
    echo "== resolution test (via 127.0.0.1) =="
    if command -v dig >/dev/null 2>&1; then
        echo "ppq.apple.com   -> $(dig +short +time=2 @127.0.0.1 ppq.apple.com 2>/dev/null | head -1) (expect 0.0.0.0)"
        echo "example.com     -> $(dig +short +time=2 @127.0.0.1 example.com 2>/dev/null | head -1) (expect a real IP)"
    elif command -v nslookup >/dev/null 2>&1; then
        nslookup ppq.apple.com 127.0.0.1 2>/dev/null | tail -n +4
    else
        echo "(no dig/nslookup to test with)"
    fi
    if [ -f "$CONF" ]; then echo; echo "== config contents =="; cat "$CONF"; fi
}

case "${1:-status}" in
    install) shift; install_dns "${1:-}" ;;
    remove)  remove_dns ;;
    status)  status_dns ;;
    *) echo "usage: omega-dns [install [upstream]|remove|status]" >&2; exit 2 ;;
esac
