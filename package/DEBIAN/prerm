#!/bin/sh
# prerm - called before the package is removed OR before an upgrade unpacks.
#   * upgrade: leave everything in place; the new postinst reloads the daemons
#     cleanly (bootout -> bootstrap) and re-applies. Tearing down here would
#     briefly unlock the ban-lists for no reason.
#   * remove/purge: stop the daemons and unlock the files so iOS can manage
#     them again.
export PATH=/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin
set -u

# $1 is "upgrade" during an upgrade, "remove" on removal. Do nothing on upgrade.
case "${1:-remove}" in
    upgrade|failed-upgrade) exit 0 ;;
esac

PREFIX=""
if [ -d /var/jb ]; then PREFIX=/var/jb; fi

LAUNCHCTL=launchctl
[ -x /var/jb/usr/bin/launchctl ] && LAUNCHCTL=/var/jb/usr/bin/launchctl
for p in "$PREFIX/Library/LaunchDaemons/party.jailbreak.omega.trigger.plist" \
         "$PREFIX/Library/LaunchDaemons/party.jailbreak.omega.ondevice.plist" \
         "$PREFIX/Library/LaunchDaemons/party.jailbreak.omega.dnsmasq.plist"; do
    $LAUNCHCTL bootout system "$p" 2>/dev/null \
        || $LAUNCHCTL unload -w "$p" 2>/dev/null || true
done
# The local-DNS daemon + its config/profile are created at runtime by
# omega-dns, so clean them here too (the package does not ship them).
rm -f "$PREFIX/Library/LaunchDaemons/party.jailbreak.omega.dnsmasq.plist" \
      "$PREFIX/etc/omega-dnsmasq.conf" 2>/dev/null || true

chflags -R noschg,nouchg /private/var/db/MobileIdentityData 2>/dev/null || true
chflags noschg,nouchg /private/var/protected/trustd/private/ocspcache.sqlite3 2>/dev/null || true
rm -rf /var/mobile/.omega 2>/dev/null || true

exit 0
