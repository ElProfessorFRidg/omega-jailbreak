#!/bin/sh
set -e

PREFIX=""
[ -d /var/jb ] && PREFIX=/var/jb

chmod 755 "$PREFIX/usr/local/bin/omega-ondevice" "$PREFIX/usr/local/bin/omega-runner" 2>/dev/null || true
chown -R root:wheel "$PREFIX/usr/local/bin/omega-ondevice" \
    "$PREFIX/usr/local/bin/omega-runner" \
    "$PREFIX/Library/LaunchDaemons/party.jailbreak.omega."* 2>/dev/null || true

# Shared trigger dir: the non-root app writes here, the root trigger daemon
# watches it. Owned by mobile so the (sandboxed-or-not) app can write.
mkdir -p /var/mobile/.omega 2>/dev/null || true
for f in cmd out trigger; do [ -e "/var/mobile/.omega/$f" ] || : > "/var/mobile/.omega/$f"; done
chown -R mobile:mobile /var/mobile/.omega 2>/dev/null || true
chmod 777 /var/mobile/.omega 2>/dev/null || true
chmod 666 /var/mobile/.omega/cmd /var/mobile/.omega/out /var/mobile/.omega/trigger 2>/dev/null || true

LAUNCHCTL=launchctl
[ -x /var/jb/usr/bin/launchctl ] && LAUNCHCTL=/var/jb/usr/bin/launchctl
for p in "$PREFIX/Library/LaunchDaemons/party.jailbreak.omega.ondevice.plist" \
         "$PREFIX/Library/LaunchDaemons/party.jailbreak.omega.trigger.plist"; do
    $LAUNCHCTL bootstrap system "$p" 2>/dev/null \
        || $LAUNCHCTL load -w "$p" 2>/dev/null || true
done

echo "Omega On-Device installed. Use the native Omega app, or it applies at boot."
echo "Reminder: block ocsp/ppq/crl/valid.apple.com at your DNS for the online side."
exit 0
